{
  "description": "element ids are unique within a screen (the renamed element also leaves an orphan item)",
  "document": {
    "schema": 1,
    "theme": {
      "font": "system-sans",
      "radius": 8,
      "colors": {
        "primary": "#4f46e5",
        "on_primary": "#ffffff",
        "text": "#111827",
        "muted": "#6b7280",
        "background": "#ffffff",
        "surface": "#f9fafb",
        "border": "#d1d5db",
        "error": "#b42318"
      }
    },
    "screens": {
      "sign_in": {
        "elements": [
          {
            "id": "title",
            "type": "text",
            "props": {
              "text": {
                "default": "Entrar",
                "i18n": {
                  "en": "Sign in"
                }
              },
              "variant": "h1"
            },
            "style": {
              "font_size": 24,
              "font_weight": 700
            }
          },
          {
            "id": "error",
            "type": "error_message",
            "props": {},
            "style": {}
          },
          {
            "id": "email",
            "type": "email_input",
            "props": {
              "label": {
                "default": "E-mail",
                "i18n": {
                  "en": "Email"
                }
              },
              "placeholder": {
                "default": "voce@exemplo.com",
                "i18n": {
                  "en": "you@example.com"
                }
              }
            },
            "style": {}
          },
          {
            "id": "email",
            "type": "password_input",
            "props": {
              "label": {
                "default": "Senha",
                "i18n": {
                  "en": "Password"
                }
              },
              "show_toggle": true
            },
            "style": {}
          },
          {
            "id": "keep_logged",
