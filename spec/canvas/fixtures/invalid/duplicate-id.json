            "style": {
              "text_align": "right"
            }
          },
          {
            "id": "login",
            "type": "login_button",
            "props": {
              "label": {
                "default": "Entrar",
                "i18n": {
                  "en": "Sign in"
                }
              }
            },
            "style": {}
          },
          {
            "id": "divider",
